---
import { Image } from 'astro:assets';
import '../styles/tokens.css';
import { primaryNav, isCurrent } from '../nav';
// Site chrome lives in src/assets so astro:assets can optimise it. Content
// images stay in public/images, where Keystatic references them by path.
import logo from '../assets/dka-logo.png';

interface Props {
  title: string;
  description?: string;
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = new URL(path, 'https://www.dkawins.com/').href;

// ---------------------------------------------------------------------------
// PRE-LAUNCH — REMOVE AT CUTOVER.
//
// This site is a near-duplicate of the live, indexed www.dkawins.com. The
// Vercel URL is publicly crawlable, so without this it competes with the real
// site in search results for DKA's own copy.
//
// Deliberately a <meta> tag and NOT a robots.txt Disallow: a Disallow stops
// crawling, which would stop Google ever seeing a noindex directive. The meta
// tag is the one that actually de-indexes.
//
// To launch: set this to false. Tracked in MIGRATION-NOTES.md § 7.5.
// ---------------------------------------------------------------------------
const NOINDEX = true;

// Organization schema. Every value here is attested on the live site — the
// founding month from /who-we-are/, the contact block from /contact-us/.
// Answer engines read this to state who DKA is; without it they infer.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://www.dkawins.com/#organization',
  name: 'DeSutter, Kerr & Associates, Inc.',
  alternateName: 'DKA',
  description:
    'Government proposal writing and GSA Schedule consulting for companies selling to federal, state and local government.',
  url: 'https://www.dkawins.com/',
  foundingDate: '1995-08',
  telephone: '+1-561-640-9171',
  email: 'info@dkahome.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5713 Corporate Way, Suite 102',
    addressLocality: 'West Palm Beach',
    addressRegion: 'FL',
    postalCode: '33407',
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
  areaServed: { '@type': 'Country', name: 'United States' },
  knowsAbout: [
    'GSA Multiple Award Schedule',
    'Government proposal writing',
    'California Multiple Award Schedule (CMAS)',
    'Texas Multiple Award Schedule (TXMAS)',
    'HUBZone certification',
    '8(a) certification',
    'Federal contract modifications',
  ],
};

// Footer sitemap: each parent that has children gets its own column, and the
// flat top-level items collect into one. Derived from the same nav source as
// the header so the two cannot disagree.
const footerColumns = [
  ...primaryNav
    .filter((item) => item.children?.length)
    .map((item) => ({
      heading: item.label,
      href: item.href,
      links: item.children!,
    })),
  {
    heading: 'Company',
    href: null,
    links: primaryNav.filter((item) => !item.children?.length),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    {/* Five pages have no live meta description (MIGRATION-NOTES.md § 3.1).
        Omit the tag entirely rather than emit an empty one. */}
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="structured-data" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="site-header__brand" href="/">
          <Image
            src={logo}
            width={150}
            densities={[1, 2]}
            loading="eager"
            alt="DeSutter, Kerr & Associates — celebrating 30 years, 1995 to 2025"
          />
        </a>

        <nav aria-label="Primary">
          <ul class="site-nav">
            {
              primaryNav.map((item) =>
                item.children?.length ? (
                  <li class="menu">
                    {/* Opens on hover, and for keyboard users via :focus-within
                        as focus enters the trigger or any link in the panel.
                        No script. The trigger stays a real link to the overview
                        page, so a device without hover still reaches it in one
                        tap rather than being stuck on a menu it must dismiss. */}
                    <a
                      class="menu__trigger"
                      href={item.href}
                      data-current={isCurrent(item, path) ? '' : undefined}
                    >
                      {item.label}
                    </a>
                    <ul class="menu__list">
                      <li>
                        <a
                          href={item.href}
                          aria-current={path === item.href ? 'page' : undefined}
                        >
                          {item.label} overview
                        </a>
                      </li>
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            aria-current={path === child.href ? 'page' : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li>
                    <a
                      href={item.href}
                      aria-current={path === item.href ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                )
              )
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav class="site-footer__nav" aria-label="Footer">
          {
            footerColumns.map((col) => (
              <div class="site-footer__col">
                <p class="site-footer__heading">
                  {col.href ? <a href={col.href}>{col.heading}</a> : col.heading}
                </p>
                <ul>
                  {col.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>

        <div class="site-footer__meta">
          <p class="site-footer__contact">
            <a href="tel:5616409171">561-640-9171</a>
            <span aria-hidden="true">·</span>
            <a href="mailto:info@dkahome.com">info@dkahome.com</a>
          </p>
          <p class="site-footer__address">
            5713 Corporate Way, Suite 102, West Palm Beach, FL 33407
          </p>
          <p class="site-footer__legal">&copy; DeSutter, Kerr &amp; Associates</p>
        </div>
      </div>
    </footer>

  </body>
</html>

<style>
  :global(*, *::before, *::after) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--size-body);
    line-height: var(--leading-body);
    -webkit-font-smoothing: antialiased;
  }

  :global(h1, h2, h3, h4) {
    font-family: var(--font-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    margin: 0;
  }

  :global(p) {
    max-width: var(--measure-prose);
  }

  :global(a) {
    color: var(--color-accent);
  }

  :global(a:hover) {
    color: var(--color-accent-hover);
  }

  /* Never remove an outline without replacing it. */
  :global(:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  :global(.wrap) {
    width: 100%;
    max-width: var(--measure-page);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
  }

  .skip-link:focus {
    left: var(--space-4);
    top: var(--space-4);
    z-index: 10;
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
  }

  /* ---- Header ---- */
  .site-header {
    border-bottom: var(--border);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
  }

  .site-header__brand {
    display: inline-flex;
    /* The logo is the accessible name for the home link; the alt text carries
       it. No text-decoration to strip because there is no text. */
  }

  .site-header__brand img {
    display: block;
    width: auto;
    height: clamp(3.25rem, 7vw, 4.75rem);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--size-small);
  }

  .site-nav a {
    text-decoration: none;
  }

  .site-nav a:hover {
    text-decoration: underline;
  }

  .site-nav a[aria-current='page'],
  .menu__trigger[data-current] {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ---- Dropdown ---- */
  /* The <li> carries the vertical padding so the trigger and the panel form one
     unbroken hover area, with no dead gap to cross on the way down. The
     matching negative margin keeps the header exactly as tall as before. */
  .menu {
    position: relative;
    padding-block: var(--space-3);
    margin-block: calc(-1 * var(--space-3));
  }

  .menu__trigger::after {
    content: '';
    display: inline-block;
    margin-inline-start: var(--space-2);
    width: 0.4em;
    height: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform 120ms ease;
  }

  .menu__list {
    position: absolute;
    top: 100%;
    /* Pulled left by its own padding so the panel's link text lines up with
       the trigger text above it. */
    inset-inline-start: calc(-1 * var(--space-3));
    z-index: 20;
    min-width: 17rem;
    margin: 0;
    padding: var(--space-3);
    list-style: none;
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(0 0 0 / 8%);

    /* Hidden without leaving the layout. The panel is out of flow in every
       state, so opening it can never push the page down. */
    opacity: 0;
    visibility: hidden;
    translate: 0 -4px;
    transition:
      opacity 120ms ease,
      translate 120ms ease,
      visibility 120ms;
  }

  .menu:focus-within > .menu__list {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .menu:focus-within > .menu__trigger::after {
    transform: translateY(0.1em) rotate(225deg);
  }

  /* Hover only where hovering is real. On a touch screen the tap follows the
     link to the overview page instead of opening a panel to dismiss. */
  @media (hover: hover) {
    .menu:hover > .menu__list {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }

    .menu:hover > .menu__trigger::after {
      transform: translateY(0.1em) rotate(225deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__list,
    .menu__trigger::after {
      transition: none;
    }

    .menu__list {
      translate: none;
    }
  }

  .menu__list li + li {
    margin-block-start: var(--space-1);
  }

  .menu__list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
  }

  .menu__list a:hover {
    background: var(--color-bg);
    text-decoration: none;
  }

  /* ---- Footer ---- */
  .site-footer {
    margin-top: var(--space-24);
    border-top: var(--border);
    padding-block: var(--space-12);
    font-size: var(--size-small);
    color: var(--color-text-muted);
  }

  .site-footer p {
    margin: 0 0 var(--space-2);
    max-width: none;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-8);
    padding-block-end: var(--space-12);
    margin-block-end: var(--space-8);
    border-bottom: var(--border);
  }

  .site-footer__heading {
    font-family: var(--font-display);
    color: var(--color-text);
    margin-block-end: var(--space-3);
  }

  .site-footer__heading a {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
