---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { navHrefs, NAV_EXEMPT } from '../nav';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const archive = await getCollection('archive');
  const stories = (await getCollection('successStories')).sort(
    (a, b) => a.data.order - b.data.order
  );

  // `path` in frontmatter is the source of truth for the URL, not the filename.
  // trailingSlash is 'always', so "/what-we-do/" -> slug "what-we-do" and
  // "/" -> undefined (the index route).
  const toSlug = (path: string) => path.replace(/^\/+|\/+$/g, '') || undefined;

  const routes = new Map<string, any>();

  // Structured .yaml pages win.
  for (const entry of pages) {
    routes.set(entry.data.path, {
      params: { slug: toSlug(entry.data.path) },
      props: {
        kind: 'data' as const,
        entry,
        // Success stories are their own collection, not fields on the page.
        // Only two routes want them: the stories page gets all of them, the
        // homepage gets the featured few for its proof block. Everywhere else
        // gets none — passing them to every page made each one sprout a
        // case-study section it never asked for.
        stories:
          entry.data.path === '/success-stories/'
            ? stories
            : entry.data.path === '/'
              ? stories.filter((st) => st.data.featured)
              : [],
      },
    });
  }

  // .mdoc archive fills any route that has no .yaml yet, so the ten indexed
  // URLs all resolve while the structured versions are still being written.
  for (const entry of archive) {
    if (routes.has(entry.data.path)) continue;
    routes.set(entry.data.path, {
      params: { slug: toSlug(entry.data.path) },
      props: { kind: 'prose' as const, entry },
    });
  }

  // Guard against the nav drifting out of sync with the routes again, which is
  // how seven pages ended up unreachable from the menu. Build-time only.
  const linked = navHrefs();
  const orphans = [...routes.keys()].filter(
    (p) => !linked.has(p) && !NAV_EXEMPT.has(p)
  );
  if (orphans.length) {
    console.warn(
      `[nav] ${orphans.length} route(s) are not linked from the site navigation:\n` +
        orphans.map((p) => `      ${p}`).join('\n') +
        `\n      Add them to src/nav.ts, or to NAV_EXEMPT if that is deliberate.`
    );
  }

  return [...routes.values()];
}

const { kind, entry, stories = [] } = Astro.props;
const d: Record<string, any> = entry.data;

// Client logos live in src/assets so astro:assets optimises them. Entries store
// a bare filename; this maps it to the imported asset.
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/clients/*.{png,jpg,jpeg,svg,webp}',
  { eager: true }
);
const logos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(logoModules).map(([path, mod]) => [
    path.split('/').pop() as string,
    mod.default,
  ])
);

// The eight logos range from 1.29:1 to 7:1. Setting them all to one HEIGHT makes
// the wide wordmarks look enormous next to the square marks; setting one WIDTH
// does the reverse. Normalising to equal AREA is what "consistent optical size"
// actually means, and it never stretches anything.
const OPTICAL_AREA = 5000;
const optical = (img: ImageMetadata) => {
  const ratio = img.width / img.height;
  const height = Math.round(Math.sqrt(OPTICAL_AREA / ratio));
  return { height, width: Math.round(height * ratio) };
};

const caseStudies = stories.filter((s: any) => s.data.kind === 'caseStudy');
const testimonials = stories.filter((s: any) => s.data.kind === 'testimonial');

// Case-study bodies are multi-paragraph; blank lines separate them.
const paragraphs = (body: string) => body.trim().split(/\n\s*\n/);

const title = d.title;
const description = kind === 'data' ? d.metaDescription : d.description;

// Only rendered for the .mdoc fallback.
const Content = kind === 'prose' ? (await render(entry)).Content : null;

// FAQPage schema for any page carrying Q&A. Answer engines quote these
// directly, so only answered questions go in — an empty <dd> would publish a
// question with no answer.
const answered = (d.groups ?? []).flatMap((g: any) =>
  (g.items ?? []).filter((i: any) => i.a?.trim())
);
const faqSchema =
  answered.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: answered.map((i: any) => ({
          '@type': 'Question',
          name: i.q,
          acceptedAnswer: { '@type': 'Answer', text: i.a.trim() },
        })),
      }
    : null;
---

<BaseLayout title={title} description={description} path={d.path}>
  {faqSchema && (
    <script
      slot="structured-data"
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  )}
  {
    kind === 'prose' ? (
      <article class="section prose-page">
        <div class="wrap">
          {/* Verbatim extraction. Heading levels are the old site's and are not
              semantic — see MIGRATION-NOTES.md § 4.6. This route is a stopgap
              until the page gets a structured .yaml. */}
          <Content />
        </div>
      </article>
    ) : (
      <>
        {d.hero && (
          <section class="section hero">
            <div class="wrap">
              <h1>{d.hero.headline}</h1>
              {d.hero.subhead && <p class="hero__subhead">{d.hero.subhead}</p>}
              {d.hero.cta && (
                <a class="button" href={d.hero.cta.href}>
                  {d.hero.cta.label}
                </a>
              )}
            </div>
          </section>
        )}

        {!d.hero && (
          <section class="section section--tight">
            <div class="wrap">
              {/* `title` is the SEO <title>, which on some pages carries a
                  pipe-separated suffix. `heading` is the visible one. */}
              <h1>{d.heading || d.title}</h1>
              {d.intro && <p class="lede">{d.intro}</p>}
            </div>
          </section>
        )}

        {/* Stat row sits immediately below the hero — these figures are DKA's
            strongest assets and were buried on the old site. */}
        {d.stats && (
          <section class="section band band--ink section--tight stats-band">
            <div class="wrap">
              <dl class="stats">
                {d.stats.map((s: any) => (
                  <div class="stat">
                    {/* Label is the <dt> and figure the <dd>: the label reads
                        as the term ("...for clients since") and the figure
                        answers it. Also puts the small text above, where these
                        labels are written to lead. */}
                    <dt class="stat__label">{s.label}</dt>
                    <dd class="stat__value">{s.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        )}

        {d.hero && d.intro && (
          <section class="section">
            <div class="wrap">
              <p class="lede">{d.intro}</p>
            </div>
          </section>
        )}

        {d.industries && (
          <section class="section">
            <div class="wrap">
              <h2>{d.industries.heading}</h2>
              <ul class="pill-list">
                {d.industries.items?.map((item: any) => (
                  <li class="pill">{item.name}</li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {/* Generic prose sections: heading plus one or more paragraphs.
            Used by the service and about pages, which are narrative rather than
            card- or list-shaped. */}
        {d.sections && (
          <section class="section">
            <div class="wrap">
              {d.sections.map((sec: any) => (
                <div class="prose-section">
                  <h2>{sec.heading}</h2>
                  {paragraphs(sec.body).map((para: string) => <p>{para}</p>)}
                </div>
              ))}
            </div>
          </section>
        )}

        {d.services && (
          <section class="section band band--surface">
            <div class="wrap">
              <h2>{d.services.heading}</h2>
              {d.services.intro && <p class="lede">{d.services.intro}</p>}
              <ul class="cards">
                {d.services.items?.map((item: any) => (
                  <li class="card">
                    <h3 class="card__title">
                      <a href={item.href}>{item.title}</a>
                    </h3>
                    <p class="card__body">{item.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {/* Homepage client proof: real logos, real quotes, real figures.
            CLAUDE.md § Homepage structure item 4 — this was missing entirely. */}
        {d.clientStories && stories.length > 0 && (
          <section class="section band band--tint">
            <div class="wrap">
              <h2>{d.clientStories.heading}</h2>
              {d.clientStories.intro && <p class="lede">{d.clientStories.intro}</p>}

              <ul class="logo-row">
                {stories.map((st: any) =>
                  st.data.logo && logos[st.data.logo] ? (
                    <li>
                      <Image
                        class="client-logo"
                        src={logos[st.data.logo]}
                        {...optical(logos[st.data.logo])}
                        densities={[1, 2]}
                        alt={`${st.data.client} logo`}
                      />
                    </li>
                  ) : null
                )}
              </ul>

              <ul class="quotes quotes--compact">
                {stories
                  .filter((st: any) => st.data.kind === 'testimonial')
                  .map((t: any) => (
                    <li class="quote">
                      <blockquote class="quote__text">
                        <p>{t.data.body.split(/(?<=\.)\s+/).slice(0, 2).join(' ')}</p>
                      </blockquote>
                      <p class="quote__attr">
                        <span class="quote__author">{t.data.author}</span>
                        {t.data.role && <span class="quote__role">{t.data.role}</span>}
                        <span class="quote__client">{t.data.client}</span>
                      </p>
                    </li>
                  ))}
              </ul>

              {d.clientStories.linkHref && (
                <p class="more-link">
                  <a href={d.clientStories.linkHref}>{d.clientStories.linkLabel}</a>
                </p>
              )}
            </div>
          </section>
        )}

        {!d.clientStories && caseStudies.length > 0 && (
          <section class="section band band--tint">
            <div class="wrap">
              <h2>Case Studies</h2>
              {caseStudies.map((cs: any) => (
                <article class="case-study">
                  {cs.data.logo && logos[cs.data.logo] && (
                    <Image
                      class="client-logo"
                      src={logos[cs.data.logo]}
                      {...optical(logos[cs.data.logo])}
                      densities={[1, 2]}
                      alt={`${cs.data.client} logo`}
                    />
                  )}
                  <p class="case-study__client">{cs.data.client}</p>
                  <h3>{cs.data.heading}</h3>
                  {paragraphs(cs.data.body).map((para: string) => <p>{para}</p>)}
                </article>
              ))}
            </div>
          </section>
        )}

        {!d.clientStories && testimonials.length > 0 && (
          <section class="section band band--surface">
            <div class="wrap">
              <h2>What Our Clients Say</h2>
              {d.testimonialsIntro && <p class="lede">{d.testimonialsIntro}</p>}
              <ul class="quotes">
                {testimonials.map((t: any) => (
                  <li class="quote">
                    {t.data.logo && logos[t.data.logo] && (
                      <Image
                        class="client-logo"
                        src={logos[t.data.logo]}
                        {...optical(logos[t.data.logo])}
                        densities={[1, 2]}
                        alt={`${t.data.client} logo`}
                      />
                    )}
                    <blockquote class="quote__text">
                      <p>{t.data.body}</p>
                    </blockquote>
                    <p class="quote__attr">
                      <span class="quote__author">{t.data.author}</span>
                      {t.data.role && <span class="quote__role">{t.data.role}</span>}
                      <span class="quote__client">{t.data.client}</span>
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {/* FAQ. Answers left empty are awaiting copy — skip them rather than
            render an empty <dd>. See faq.yaml. */}
        {d.groups && (
          <section class="section band band--surface">
            <div class="wrap">
              {d.groups.map((group: any) => (
                <div class="faq-group">
                  <h2>{group.heading}</h2>
                  <dl class="faq">
                    {group.items
                      ?.filter((item: any) => item.a?.trim())
                      .map((item: any) => (
                        <div class="faq__item">
                          <dt class="faq__q">{item.q}</dt>
                          <dd class="faq__a">{item.a}</dd>
                        </div>
                      ))}
                  </dl>
                </div>
              ))}
            </div>
          </section>
        )}

        {d.whyDka && (
          <section class="section band band--tint">
            <div class="wrap">
              <h2>{d.whyDka.heading}</h2>
              <ul class="checklist">
                {d.whyDka.items?.map((item: string) => <li>{item}</li>)}
              </ul>
            </div>
          </section>
        )}

        {d.cta && (
          <section class="section band band--ink cta-band">
            <div class="wrap">
              <h2>{d.cta.heading}</h2>
              {d.cta.body && <p>{d.cta.body}</p>}
              <a class="button" href={d.cta.href}>
                {d.cta.label}
              </a>
            </div>
          </section>
        )}
      </>
    )
  }
</BaseLayout>

<style>
  .section {
    padding-block: var(--section-pad);
  }

  .section + .section {
    padding-block-start: 0;
  }

  /* ---- Bands ----
     Contrast comes from alternating surface VALUE, not from more hues.

     A band paints a background, so it needs padding on BOTH sides regardless of
     what precedes it. The second selector is not redundant: Astro scopes every
     compound selector with its own attribute, so `.section + .section` above
     resolves to two attribute selectors and outranks a single `.section.band`.
     Matching its shape is what lets this win. Without it a band gets full
     padding underneath and none on top. */
  .section.band,
  .section + .section.band {
    padding-block: var(--section-pad);
  }

  /* A stat row is a band of short lines, not a section of prose. Full section
     padding leaves it floating in empty colour. */
  .section.band.section--tight,
  .section + .section.band.section--tight {
    padding-block: var(--space-12);
  }

  .band--surface {
    background: var(--color-surface);
  }

  .band--tint {
    background: var(--color-surface-tint);
  }

  /* Redefines the colour tokens locally, so every descendant — links, muted
     text, rules — inverts without needing its own override. */
  .band--ink {
    background: var(--color-ink);
    color: var(--color-ink-text);
    --color-text: var(--color-ink-text);
    --color-text-muted: var(--color-ink-muted);
    --color-accent: var(--color-accent-on-ink);
    --color-rule: var(--color-ink-rule);
  }

  /* A mid-blue fill on navy is unreadable, so the button inverts too. */
  .band--ink .button {
    background: var(--color-ink-text);
    color: var(--color-ink);
  }

  .band--ink .button:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .section--tight {
    padding-block: var(--space-16);
  }

  h1 {
    font-size: var(--size-h1);
    max-width: 18ch;
  }

  h2 {
    font-size: var(--size-h2);
    margin-block-end: var(--space-8);
  }

  h3 {
    font-size: var(--size-h3);
  }

  .lede {
    font-size: var(--size-lede);
    color: var(--color-text-muted);
  }

  .hero__subhead {
    font-size: calc(var(--size-body) * 1.25);
    color: var(--color-text-muted);
    margin-block: var(--space-6) var(--space-8);
  }

  .button {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    text-decoration: none;
    font-size: var(--size-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius);
  }

  .button:hover {
    background: var(--color-accent-hover);
    color: var(--color-accent-contrast);
  }

  /* ---- Stats ----
     The strongest band on the page. CLAUDE.md calls these DKA's best assets and
     notes they were buried on the old site; on ink they are the first thing the
     eye lands on after the headline. */
  .stats-band {
    border-block: none;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    /* Tighter down the page than across it — wrapped rows should not open up
       as much as neighbouring columns need to stay apart. */
    gap: var(--space-8) var(--space-12);
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  /* Label first, so it sits above the figure it introduces. */
  .stat__label {
    margin: 0 0 var(--space-2);
    font-size: var(--size-small);
    line-height: 1.4;
    color: var(--color-text-muted);
    max-width: 26ch;
    text-wrap: balance;
  }

  .stat__value {
    /* <dd> carries a browser default indent; the grid handles alignment. */
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-stat);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  /* ---- Client logos ----
     Height and width are set per-logo at build time from the source aspect
     ratio (see `optical` above), so nothing is stretched and nothing dominates.
     The cap here is a safety net for a very wide mark on a narrow screen. */
  .client-logo {
    display: block;
    max-width: 100%;
    height: auto;
    margin-block-end: var(--space-4);
  }

  .logo-row {
    list-style: none;
    margin: 0 0 var(--space-16);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-12);
  }

  .logo-row .client-logo {
    margin-block-end: 0;
  }

  .quotes--compact {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    display: grid;
    gap: var(--space-8);
  }

  .quotes--compact .quote {
    max-width: none;
  }

  .more-link {
    margin-block-start: var(--space-12);
  }

  /* ---- Prose sections ---- */
  .prose-section + .prose-section {
    margin-block-start: var(--space-12);
  }

  .prose-section p {
    max-width: var(--measure-prose);
  }

  .prose-section p + p {
    margin-block-start: var(--space-4);
  }

  /* ---- Cards ---- */
  .cards,
  .quotes,
  .pill-list,
  .checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .card {
    border-top: 2px solid var(--color-accent);
    padding-block-start: var(--space-6);
  }

  .card__title a {
    text-decoration: none;
  }

  .card__title a:hover {
    text-decoration: underline;
  }

  .card__body {
    color: var(--color-text-muted);
    font-size: var(--size-small);
  }

  /* ---- Case studies ---- */
  .case-study {
    border-top: var(--border);
    padding-block: var(--space-8);
    max-width: var(--measure-prose);
  }

  .case-study__client {
    font-size: var(--size-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2);
  }

  /* ---- Quotes ---- */
  .quotes {
    display: grid;
    gap: var(--space-12);
  }

  .quote {
    max-width: var(--measure-prose);
  }

  .quote__text {
    margin: 0;
    padding-inline-start: var(--space-6);
    border-inline-start: 2px solid var(--color-accent);
  }

  .quote__attr {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-6);
    font-size: var(--size-small);
    color: var(--color-text-muted);
  }

  .quote__author {
    color: var(--color-text);
    font-weight: 600;
  }

  .quote__role::before,
  .quote__client::before {
    content: '·';
    margin-inline-end: var(--space-2);
  }

  /* ---- Pills / checklist ---- */
  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .pill {
    border: var(--border);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    font-size: var(--size-small);
  }

  .checklist {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-prose);
  }

  .checklist li {
    border-inline-start: 2px solid var(--color-accent);
    padding-inline-start: var(--space-4);
  }

  /* ---- FAQ ---- */
  .faq-group + .faq-group {
    margin-block-start: var(--space-16);
  }

  .faq {
    margin: 0;
    max-width: var(--measure-prose);
  }

  .faq__item + .faq__item {
    margin-block-start: var(--space-8);
  }

  .faq__q {
    font-family: var(--font-display);
    font-size: var(--size-h3);
  }

  .faq__a {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }

  /* ---- CTA ---- */
  .cta-band {
    border-top: var(--border);
    margin-block-start: var(--space-16);
  }

  .cta-band .button {
    margin-block-start: var(--space-6);
  }

  /* ---- Prose fallback ---- */
  /* The extracted WordPress markup uses heading levels for sizing rather than
     structure (MIGRATION-NOTES.md § 4.6): h3 carries body copy, h5 carries the
     page lede, and one page has two h1s. These rules map the old levels onto
     the same three sizes the structured pages use, so a page title is the same
     size on every page regardless of which source it came from. */
  .prose-page :global(h1) {
    font-size: var(--size-h1);
    margin-block-end: var(--space-6);
  }

  /* A second h1 on the page is a markup artifact, not a second page title.
     Demote it visually; the tag itself stays as extracted. */
  .prose-page :global(h1 ~ h1) {
    font-size: var(--size-h2);
    margin-block: var(--space-12) var(--space-4);
  }

  .prose-page :global(h2) {
    font-size: var(--size-h2);
    margin-block: var(--space-12) var(--space-4);
  }

  .prose-page :global(h3),
  .prose-page :global(h4) {
    font-size: var(--size-h3);
    margin-block: var(--space-8) var(--space-3);
  }

  /* h5 is the old site's intro line, not a heading. Rendered as lede text it
     stops competing with the real headings around it. */
  .prose-page :global(h5) {
    font-family: var(--font-body);
    font-size: var(--size-lede);
    font-weight: 400;
    line-height: var(--leading-body);
    letter-spacing: normal;
    color: var(--color-text-muted);
    max-width: var(--measure-prose);
    margin-block: var(--space-4) var(--space-8);
  }

  .prose-page :global(p) {
    max-width: var(--measure-prose);
  }
